# ------------------------------------------
# Docker
# ------------------------------------------
# Override files (used for local dev overrides, should not be committed)
docker-compose.override.yml

# Docker build cache and temporary files
*.tar
*.tar.gz

# ------------------------------------------
# Environment and Secrets
# ------------------------------------------
# Environment variable files that may contain sensitive data
.env
*.env
.env.*
!.env.example

# ------------------------------------------
# Node.js
# ------------------------------------------
# Node modules are built inside the container, never commit them
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ------------------------------------------
# Python
# ------------------------------------------
# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# ------------------------------------------
# TrueNAS Volume Data
# ------------------------------------------
# Never commit mounted volume data from your TrueNAS datasets
magicmirror-data/
mmpm-data/
config/
modules/
css/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------
# IDE and Editor Files
# ------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*.swn
*.vim
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.emacs.desktop
.emacs.desktop.lock

# ------------------------------------------
# Logs and Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.backup
*.orig

# ------------------------------------------
# Miscellaneous
# ------------------------------------------
# Coverage reports
coverage/
.nyc_output/

# Build output
dist/
build/
